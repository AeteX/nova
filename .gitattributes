# Normalize line endings
* text=auto

# Source code — LF
*.rs      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.html    text eol=lf
*.sh      text eol=lf

# Windows scripts need CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf

# Binary — never touch
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.woff    binary
*.woff2   binary
*.gguf    binary

# Exclude generated files from GitHub language stats
src-tauri/target/* linguist-vendored
src-tauri/gen/*    linguist-vendored
node_modules/*     linguist-vendored
dist/*             linguist-vendored
package-lock.json  linguist-generated
src-tauri/Cargo.lock linguist-generated